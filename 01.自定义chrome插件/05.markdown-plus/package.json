{
  "name": "markdown-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome 扩展：拖入 .md 文件即可预览与编辑",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "tocbot": "^4.36.8",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
